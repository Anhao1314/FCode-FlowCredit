{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fcode.audit-bundle/v1",
  "title": "Audit bundle manifest",
  "description": "The export a third party needs to re-run the audit's conclusions without talking to the auditor: pinned target, session split, tool versions, every poc-evidence record, root-cause-merged finding index, uncovered surfaces, authorization statement and the chain verification entry. Companion to fcode.poc-evidence/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "authorization",
    "target",
    "sessions",
    "toolchain",
    "poc_evidence_refs",
    "findings",
    "uncovered_surfaces",
    "chain_verification"
  ],
  "properties": {
    "schema_version": {
      "const": "fcode.audit-bundle/v1"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "scope",
        "granted_at"
      ],
      "properties": {
        "operator": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "time_window": {
          "type": "string"
        },
        "granted_at": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "manifest_sha256"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_profile_note": {
          "type": "string"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rea_evidence_id": {
          "type": "string",
          "pattern": "^ev_[0-9a-f]{64}$"
        },
        "target_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string"
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "session_ref"
        ],
        "properties": {
          "phase": {
            "enum": [
              "profile",
              "static",
              "dynamic",
              "governance",
              "report"
            ]
          },
          "session_ref": {
            "type": "string"
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayer",
        "oracle_version"
      ],
      "properties": {
        "analyst_model": {
          "type": "string"
        },
        "triage_model": {
          "type": "string"
        },
        "replayer": {
          "type": "string"
        },
        "oracle_version": {
          "type": "string"
        },
        "ruleset_version": {
          "type": "integer",
          "minimum": 1
        },
        "rea": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "evidence_schema",
            "facts_schema"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "evidence_schema": {
              "type": "string"
            },
            "facts_schema": {
              "type": "string"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "poc_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "root_cause_group",
          "category",
          "severity",
          "poc_refs"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "root_cause_group": {
            "type": "string"
          },
          "category": {
            "enum": [
              "AGI-01",
              "AGI-02",
              "AGI-03",
              "AGI-04",
              "AGI-05",
              "AGI-06",
              "AGI-07",
              "AGI-08",
              "AGI-09",
              "VIBE-01",
              "VIBE-02",
              "VIBE-03",
              "VIBE-04",
              "VIBE-05",
              "VIBE-06",
              "VIBE-07",
              "WEB-01",
              "WEB-02",
              "WEB-03",
              "WEB-04",
              "WEB-05",
              "WEB-06",
              "WEB-07"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "poc_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "operator_disposition": {
            "enum": [
              "accepted_risk",
              "false_positive_disputed",
              "wont_fix"
            ]
          },
          "fingerprint": {
            "description": "Stable per-instance identity (v2 exact): root cause, normalized evidence path set and semantic anchors. Line numbers, snippets, counts and timestamps are excluded. Two findings from the same rule at different sites remain distinct.",
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "semantic_fingerprint": {
            "description": "v2 root-cause identity without evidence paths; recognizes the same defect after a file move.",
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "legacy_fingerprint": {
            "description": "v1 path-set fingerprint retained for one-time compatibility with older episodes.",
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "fingerprint_version": {
            "description": "Identity algorithm version; 2 adds semantic anchors and file-move matching.",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "regression": {
      "description": "Derived comparison against the previous audit of the same target identity. Present only when a baseline exists; counts match regression.json, which carries the full buckets.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_audit_id",
        "prior_manifest_sha256",
        "known",
        "new",
        "fixed",
        "regressed"
      ],
      "properties": {
        "prior_audit_id": {
          "type": "string"
        },
        "prior_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "regressed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "uncovered_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "reason"
        ],
        "properties": {
          "surface": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "rea_evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "operation",
          "path",
          "sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{64}$"
          },
          "operation": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "rea_facts_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rea_control_facts_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "chain_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_hash",
        "command"
      ],
      "properties": {
        "head_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command": {
          "type": "string"
        }
      }
    }
  }
}
