{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fcode.spec-gap-report/v1",
  "title": "Spec gap report",
  "description": "Standalone report for checked-and-conforms and undetermined (specification gap) judgments. It is not an audit-bundle finding: findings require a replay-backed PoC, while these judgments are documentation/observation conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "audit_id", "target", "generated_at", "judgments"],
  "properties": {
    "schema_version": { "const": "fcode.spec-gap-report/v1" },
    "report_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" },
    "audit_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "artifact_sha256", "session_log_sha256"],
      "properties": {
        "identity": { "type": "string" },
        "version": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "session_log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["judgment_id", "subject", "verdict", "evidence_refs"],
        "properties": {
          "judgment_id": { "type": "string", "pattern": "^SG-[0-9]{4,}$" },
          "subject": { "type": "string" },
          "verdict": { "enum": ["conforms", "undetermined"] },
          "basis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["doc_refs"],
            "properties": {
              "kind": { "type": "string" },
              "doc_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          },
          "missing_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "searched_refs", "result"],
            "properties": {
              "question": { "type": "string" },
              "searched_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "result": { "type": "string" }
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "session_id", "seq", "event_type", "log_path", "log_sha256", "log_format"],
              "properties": {
                "kind": { "enum": ["dsh_event"] },
                "session_id": { "type": "string" },
                "seq": { "type": "integer", "minimum": 0 },
                "event_type": { "type": "string" },
                "log_path": { "type": "string" },
                "log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "log_format": { "enum": ["jsonl", "zstd"] }
              }
            }
          },
          "absence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "session_id", "event_type", "scope"],
              "properties": {
                "kind": { "enum": ["dsh_event_absence"] },
                "session_id": { "type": "string" },
                "event_type": { "type": "string" },
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from_seq", "to_seq"],
                  "properties": {
                    "from_seq": { "type": "integer", "minimum": 0 },
                    "to_seq": { "type": "integer", "minimum": 0 },
                    "turn": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}