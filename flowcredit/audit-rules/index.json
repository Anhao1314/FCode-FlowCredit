{
  "version": 6,
  "rules": [
    {
      "id": "RULE-AGI02-001",
      "status": "active",
      "category": "AGI-02",
      "severity": "high",
      "title": "Remembered approval keyed by tool name whitelists all future arguments",
      "root_cause_group": "approval-memory",
      "trigger": {
        "type": "static",
        "file_glob": "**/*.py",
        "any_of": [
          "_remembered\\.add\\(tool\\)",
          "tool in self\\._remembered"
        ]
      },
      "poc": {
        "scenario": "fcode02_remember_scope",
        "scenario_by_profile": {
          "demo-target": "demoagent_remember_scope"
        },
        "stimulus": "approve run_command ['ls','-la'] with remember=true; then issue run_command ['python','payload.py'] in the same run",
        "capabilities": [
          {
            "kind": "filesystem_write",
            "scope": "temporary workspace copy only",
            "granted": true
          },
          {
            "kind": "filesystem_read",
            "scope": "target copy",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "event_absent",
          "spec": "no approval event recorded for the second call; approval granted by=operator-rule; the host queries the event chain itself and never reads PoC output as verdict"
        },
        "threshold": "1/1 (deterministic defect)",
        "negative_control": {
          "spec": "same stimulus with remember=false: the second call must pause and produce an approval_requested event"
        },
        "probe_params": {
          "remember": true
        },
        "control_params": {
          "remember": false
        }
      },
      "references": [
        "fixtures/fcode-self/known-issues.json#FCODE-02",
        "viewer/console_runtime.py:722-727"
      ]
    },
    {
      "id": "RULE-AGI02-002",
      "status": "active",
      "category": "AGI-02",
      "severity": "high",
      "title": "Tool execution path performs no permission checks (gate is a call convention)",
      "root_cause_group": "ungated-execute",
      "trigger": {
        "type": "static",
        "file_glob": "**/harness.py",
        "any_of": [
          "def execute\\(self, task"
        ]
      },
      "poc": {
        "scenario": "fcode06_ungated_execute",
        "stimulus": "Harness.execute dispatches list_documents while the task's allowed_tools contains only run_command",
        "capabilities": [
          {
            "kind": "filesystem_write",
            "scope": "temporary workspace copy only",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "event_present",
          "spec": "tool_succeeded recorded for list_documents while it is absent from task.allowed_tools; the host queries the chain itself"
        },
        "threshold": "1/1 (deterministic defect)",
        "probe_params": {
          "mode": "probe"
        },
        "control_params": {
          "mode": "control"
        },
        "control_oracle": {
          "kind": "host_decision",
          "spec": "permissions.gate denies list_documents (not in allowed_tools) — the gate works; the flaw is that execute never calls it"
        },
        "negative_control": {
          "spec": "the same call submitted through permissions.gate must be denied"
        }
      },
      "references": [
        "fixtures/fcode-self/known-issues.json#FCODE-06",
        "runtime/harness.py:379-443"
      ]
    },
    {
      "id": "RULE-AGI03-001",
      "status": "active",
      "category": "AGI-03",
      "severity": "high",
      "title": "Plaintext credential assigned as a source literal",
      "root_cause_group": "plaintext-secret",
      "trigger": {
        "type": "static",
        "file_glob": "**/*.py",
        "any_of": [
          "[A-Za-z_]{0,32}[Kk][Ee][Yy]\\s*=\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']"
        ]
      },
      "poc": {
        "scenario": "static_file_evidence",
        "stimulus": "re-read the flagged file inside the pinned target copy and re-apply the secret-shaped pattern",
        "capabilities": [
          {
            "kind": "filesystem_read",
            "scope": "target copy",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "file_state",
          "spec": "the file inside the pinned copy assigns a key-shaped literal; the host re-reads the file itself and never trusts the scan report"
        },
        "threshold": "1/1 (deterministic defect)",
        "probe_params": {
          "mode": "probe",
          "path": "mini_agent/config.py",
          "pattern": "[A-Za-z_]{0,32}[Kk][Ee][Yy]\\s*=\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']"
        },
        "control_params": {
          "mode": "control",
          "path": "README.md",
          "pattern": "[A-Za-z_]{0,32}[Kk][Ee][Yy]\\s*=\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']"
        },
        "control_oracle": {
          "kind": "file_state",
          "spec": "the control file (target README) contains no key-shaped assignment"
        },
        "negative_control": {
          "spec": "the same pattern over the target's README must not match"
        }
      },
      "references": [
        "docs/threat-model.md AGI-03",
        "fixtures/demo-target/README.md"
      ]
    },
    {
      "id": "RULE-AGI05-101",
      "status": "active",
      "category": "AGI-05",
      "severity": "medium",
      "title": "Shipped dependency graph contains pre-release modules",
      "root_cause_group": "prerelease-dependencies",
      "trigger": {
        "type": "rea",
        "operation": "inspect_go_binary",
        "selector": "dependencies",
        "predicate": {
          "any": {
            "field": "prerelease",
            "equals": true
          }
        }
      },
      "poc": {
        "scenario": "rea_fact_evidence",
        "stimulus": "host re-reads the pinned REA facts snapshot and selects the dependency rows",
        "capabilities": [
          {
            "kind": "filesystem_read",
            "scope": "pinned REA facts snapshot",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "host_decision",
          "spec": "the host reads the pinned facts itself and requires a dependency row whose version is a pre-release; a REA claim alone is not a finding"
        },
        "threshold": "1/1 (deterministic fact)",
        "probe_params": {
          "mode": "probe",
          "facts_path": "facts.json",
          "operation": "inspect_go_binary",
          "selector": "dependencies"
        },
        "control_params": {
          "mode": "control",
          "facts_path": "control-facts.json",
          "operation": "inspect_go_binary",
          "selector": "dependencies"
        },
        "control_oracle": {
          "kind": "host_decision",
          "spec": "the control facts projection contains no pre-release dependency"
        },
        "negative_control": {
          "spec": "the same selector over a facts projection with pre-release rows removed must not produce a finding"
        }
      },
      "references": [
        "docs/integration-rea.md#rules",
        "docs/threat-model.md AGI-05",
        "fixtures/rea/facts-prerelease.json"
      ]
    },
    {
      "id": "RULE-AGI07-101",
      "status": "active",
      "category": "AGI-07",
      "severity": "high",
      "title": "Application requests OS entitlements not declared by the operator",
      "root_cause_group": "entitlement-overreach",
      "trigger": {
        "type": "rea",
        "operation": "host",
        "selector": "entitlements",
        "predicate": {
          "count_gt": 0
        }
      },
      "poc": {
        "scenario": "rea_fact_evidence",
        "stimulus": "host re-reads the pinned entitlements and the operator's declared feature list",
        "capabilities": [
          {
            "kind": "filesystem_read",
            "scope": "pinned REA facts snapshot",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "host_decision",
          "spec": "the host computes entitlements minus declared_features from the pinned facts; a non-empty difference is the finding"
        },
        "threshold": "1/1 (deterministic fact)",
        "probe_params": {
          "mode": "probe",
          "facts_path": "facts.json",
          "operation": "host",
          "selector": ""
        },
        "control_params": {
          "mode": "control",
          "facts_path": "control-facts.json",
          "operation": "host",
          "selector": ""
        },
        "control_oracle": {
          "kind": "host_decision",
          "spec": "the control projection declares every observed entitlement, so the difference is empty"
        },
        "negative_control": {
          "spec": "the same comparison over facts whose declared_features cover every entitlement must not produce a finding"
        }
      },
      "references": [
        "docs/integration-rea.md#rules",
        "docs/threat-model.md AGI-07",
        "fixtures/rea/facts-entitlements.json"
      ]
    },
    {
      "id": "RULE-AGI02-102",
      "status": "active",
      "category": "AGI-02",
      "severity": "medium",
      "title": "Bundled sidecar exposes a listener without an authorization marker",
      "root_cause_group": "sidecar-listener-auth",
      "trigger": {
        "type": "rea",
        "operation": "host",
        "selector": "sidecars",
        "predicate": {
          "any": {
            "field": "listener_without_auth",
            "count_gt": 0
          }
        }
      },
      "poc": {
        "scenario": "rea_fact_evidence",
        "stimulus": "host re-reads the sidecar source facts and checks every listener for an authorization marker",
        "capabilities": [
          {
            "kind": "filesystem_read",
            "scope": "pinned REA facts snapshot",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "host_decision",
          "spec": "the host selects sidecars whose listener list is non-empty and auth_markers is empty; a listener without an auth marker is the finding"
        },
        "threshold": "1/1 (deterministic fact)",
        "probe_params": {
          "mode": "probe",
          "facts_path": "facts.json",
          "operation": "host",
          "selector": "sidecars"
        },
        "control_params": {
          "mode": "control",
          "facts_path": "control-facts.json",
          "operation": "host",
          "selector": "sidecars"
        },
        "control_oracle": {
          "kind": "host_decision",
          "spec": "the control projection marks every sidecar listener as authenticated"
        },
        "negative_control": {
          "spec": "the same selection over facts whose sidecar listeners all have auth markers must not produce a finding"
        }
      },
      "references": [
        "docs/integration-rea.md#rules",
        "docs/threat-model.md AGI-02",
        "fixtures/rea/sidecar-unauth.json"
      ]
    },
    {
      "id": "RULE-AGI03-102",
      "status": "active",
      "category": "AGI-03",
      "severity": "high",
      "title": "Bundled sidecar source contains a key-shaped literal",
      "root_cause_group": "sidecar-secret-literal",
