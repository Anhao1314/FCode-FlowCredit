        "type": "rea",
        "operation": "host",
        "selector": "sidecars",
        "predicate": {
          "any": {
            "field": "npm_install",
            "count_gt": 0
          }
        }
      },
      "poc": {
        "scenario": "rea_fact_evidence",
        "stimulus": "host re-reads the sidecar source facts and confirms npm install/exec references",
        "capabilities": [
          {
            "kind": "filesystem_read",
            "scope": "pinned REA facts snapshot",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "host_decision",
          "spec": "the host selects sidecars with non-empty npm_install; a bundled runtime that can fetch packages at runtime is the finding"
        },
        "threshold": "1/1 (deterministic fact)",
        "probe_params": {
          "mode": "probe",
          "facts_path": "facts.json",
          "operation": "host",
          "selector": "sidecars"
        },
        "control_params": {
          "mode": "control",
          "facts_path": "control-facts.json",
          "operation": "host",
          "selector": "sidecars"
        },
        "control_oracle": {
          "kind": "host_decision",
          "spec": "the control projection removes every npm install/exec row"
        },
        "negative_control": {
          "spec": "the same selection over facts whose sidecars do not invoke npm at runtime must not produce a finding"
        }
      },
      "references": [
        "docs/integration-rea.md#rules",
        "docs/threat-model.md AGI-05",
        "fixtures/rea/sidecar-npm.json"
      ]
    },
    {
