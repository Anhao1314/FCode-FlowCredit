        "type": "rea",
        "operation": "host",
        "selector": "sidecars",
        "predicate": {
          "any": {
            "field": "secret_like",
            "count_gt": 0
          }
        }
      },
      "poc": {
        "scenario": "rea_fact_evidence",
        "stimulus": "host re-reads the sidecar source facts and confirms a key-shaped literal at file:line",
        "capabilities": [
          {
            "kind": "filesystem_read",
            "scope": "pinned REA facts snapshot",
            "granted": true
          },
          {
            "kind": "network",
            "scope": "none",
            "granted": false
          },
          {
            "kind": "credentials",
            "scope": "none",
            "granted": false
          }
        ],
        "oracle": {
          "kind": "host_decision",
          "spec": "the host selects sidecars with non-empty secret_like; the record keeps only file/line/kind, never the literal"
        },
        "threshold": "1/1 (deterministic fact)",
        "probe_params": {
          "mode": "probe",
          "facts_path": "facts.json",
          "operation": "host",
          "selector": "sidecars"
        },
        "control_params": {
          "mode": "control",
          "facts_path": "control-facts.json",
          "operation": "host",
          "selector": "sidecars"
        },
        "control_oracle": {
          "kind": "host_decision",
          "spec": "the control projection removes every key-shaped literal"
        },
        "negative_control": {
          "spec": "the same selection over facts whose sidecars have no secret_like rows must not produce a finding"
        }
      },
      "references": [
        "docs/integration-rea.md#rules",
        "docs/threat-model.md AGI-03",
        "fixtures/rea/sidecar-secret.json"
      ]
    },
    {
      "id": "RULE-AGI05-102",
      "status": "active",
      "category": "AGI-05",
      "severity": "medium",
      "title": "Bundled sidecar source invokes npm install/exec at runtime",
